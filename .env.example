# MCP server name — the key used in Claude Desktop's claude_desktop_config.json
# and the name advertised to Claude. Change to run multiple deployments side by
# side (e.g. "work-notes", "personal-notes").
MCP_SERVER_NAME=local-rag

# Absolute path to the folder containing .md files to index (used by ingest.py)
NOTES_DIR=/Users/<you>/Documents/notes

# Absolute path to the sqlite database (created on first ingest)
MEMORY_DB=/Users/<you>/local-rag/data/memory.db

# Path to the extensions directory (populated by setup/download_extensions.py)
EXTENSIONS_DIR=/Users/<you>/local-rag/data/extensions

# Path to the GGUF model file (populated by setup/download_model.py)
MODEL_PATH=/Users/<you>/local-rag/data/models/multilingual-e5-large-instruct-q8_0.gguf

# Optional hybrid search tuning (defaults tuned for Polish: balanced 0.5/0.5 instead of sqlite-memory defaults 0.6/0.4)
MEMORY_VECTOR_WEIGHT=0.5
MEMORY_TEXT_WEIGHT=0.5
MEMORY_MAX_RESULTS=10
MEMORY_MIN_SCORE=0.6
